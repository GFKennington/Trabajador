    "words": [
        "trabajador",
        "hono",
        "biomejs",
        "mise",
        "husky",
        "commitlint",
        "lint-staged",
        "tsx",
        "ampacity",
        "Kennington",
        "Stott",
        "metroconfig",
        "nodejs",
        "Pressable",
        "Nativewind",
        "Tamagui",
        "unistyles",
        "Maru",
        "grantkteam",
        "grantk",
        "srgb",
        "worklets",
        "predev",
        "npmjs",
        "alstr",
        "KHTML"
    ],
    "ignoreWords": [],
    "flagWords": []
}
