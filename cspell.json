{
    "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
    "version": "0.2",
    "language": "en",
    "ignorePaths": [
        "node_modules",
        "**/node_modules",
        "**/dist",
        "**/.expo",
        "**/web-build",
        "**/ios",
        "**/android",
        "package-lock.json",
        "**/*.tsbuildinfo",
        ".git"
    ],
    "globRoot": ".",
