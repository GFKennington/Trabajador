{
    "name": "trabajador",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "tsc -b && npm run build -w trabajador-server && npm run export:web -w trabajador-client",
        "typecheck": "tsc -b && tsc --noEmit -p packages/client/tsconfig.json",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check .",
        "spellcheck": "cspell lint .",
        "check-links": "lychee --config lychee.toml .",
        "scan-secrets": "gitleaks detect --source . --config .gitleaks.toml --no-banner --redact",
        "ci": "biome ci --error-on-warnings . && npm run spellcheck && npm run check-links && npm run scan-secrets && npm run typecheck && npm run build",
        "dev:server": "npm run dev -w trabajador-server",
        "dev:client": "npm run start -w trabajador-client",
        "test": "npm run test -ws --if-present",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched",
        "*.{js,jsx,ts,tsx,json,md,css,sh,toml,yml,yaml}": "cspell lint --no-must-find-files"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.11",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "cspell": "^10.1.1",
        "concurrently": "^10.0.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.4.1",
        "typescript": "~6.0.3"
    },
    "engines": {
        "node": ">=24"
    }
}
