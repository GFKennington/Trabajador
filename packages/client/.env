# Client default environment.
# This file IS committed (safe defaults only — no secrets).
# Personal/local overrides go in .env.local (gitignored).
#
# Expo reads EXPO_PUBLIC_* vars at build/runtime; prefix any value
# the client bundle should see with EXPO_PUBLIC_.

# Default API base URL the client calls.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
