# Server default environment (committed; safe defaults only -- no secrets).
# Local overrides go in .env.local (gitignored).
#
# Loaded by the dev script (Node --env-file-if-exists), not by the server.
# In production the platform injects env vars; this file is not used.
# Precedence (high -> low): platform env > .env.local > this file.

# Port the server listens on.
PORT=3000
