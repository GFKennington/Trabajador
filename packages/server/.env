# Server default environment.
# This file IS committed (safe defaults only — no secrets).
# Personal/local overrides go in .env.local (gitignored).
#
# Precedence (low -> high): root .env < package .env
# < root .env.local < package .env.local

# Port the server listens on.
PORT=3000

# Log level: debug | info | warn | error
LOG_LEVEL=info
