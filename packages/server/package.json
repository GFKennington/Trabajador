{
    "name": "trabajador-server",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "concurrently -n shared,server -c blue,green \"tsc -b --watch\" \"tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/index.ts\"",
        "predev": "tsc -b",
        "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.js",
        "start": "node dist/index.js"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.1",
        "trabajador-shared": "0.0.0",
        "hono": "^4.13.5"
    },
    "devDependencies": {
        "@types/node": "^26.0.0",
        "esbuild": "^0.28.2",
        "tsx": "^4.23.12",
        "typescript": "~6.0.3"
    }
}
